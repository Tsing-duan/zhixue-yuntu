# DeepSeek AI 配置（API Key 可留空；非 AI 功能仍可启动）
# 不要在仓库中填写真实 API Key。
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_CONNECT_TIMEOUT_MS=5000
DEEPSEEK_READ_TIMEOUT_MS=120000

# JWT 签名密钥（必填，至少 32 字符；可用 `openssl rand -hex 32` 生成）
# 不要在仓库中填写真实值。
JWT_SECRET=

# 数据库配置（本地启动脚本会询问本机 MySQL root 密码）
DB_PASSWORD=your_password_here
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=online_learn
# DB_USER=root

# Druid 监控面板
DRUID_USERNAME=admin
DRUID_PASSWORD=your_druid_password_here

# Redis 配置
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
